		{
			"label": "npm: lint",
			"type": "npm",
			"script": "lint",
			"problemMatcher": []
		},
		{
			"label": "npm: format",
			"type": "npm",
			"script": "format",
			"problemMatcher": []
		},
		{
			"label": "npm: build",
			"type": "npm",
			"script": "build",
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "npm: build:emit",
			"type": "npm",
			"script": "build:emit",
			"problemMatcher": ["$tsc"],
			"group": "build"
		},
		{
			"label": "npm: lint:package",
			"type": "npm",
			"script": "lint:package",
			"problemMatcher": []
		},
		{
			"label": "npm: api:update",
			"type": "npm",
			"script": "api:update",
			"problemMatcher": ["$tsc"]
