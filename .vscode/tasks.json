{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "npm: check",
			"type": "npm",
			"script": "check",
			"problemMatcher": ["$tsc"],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
