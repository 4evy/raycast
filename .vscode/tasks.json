			"problemMatcher": []
		},
		{
			"label": "npm: source:latest",
			"type": "npm",
			"script": "source:latest",
			"problemMatcher": []
		},
		{
			"label": "npm: source:api",
			"type": "npm",
			"script": "source:api",
			"problemMatcher": []
