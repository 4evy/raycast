{
	"name": "raycast",
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"node": ">=26.10.0"
	},
	"scripts": {
		"check": "npm run typecheck && npm run lint && npm run build",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"cli": "node src/cli/main.mts",
		"db": "node src/cli/main.mts db",
		"ai": "node src/cli/main.mts ai",
		"key": "node src/cli/main.mts key",
		"configure": "node src/cli/main.mts configure",
		"themes": "node src/cli/main.mts themes",
		"source:sync": "npm run --prefix packages/raycast-source source:sync",
		"release:update": "npm run --prefix packages/raycast-source release:update",
		"release:commit": "npm run --prefix packages/raycast-source release:commit",
		"source:inspect": "npm run --prefix packages/raycast-source source:inspect",
		"source:latest": "npm run --prefix packages/raycast-source source:latest",
		"source:api": "npm run --prefix packages/raycast-source source:api",
		"build": "npm run build:emit && api-extractor run && npm run lint:package",
		"prepack": "npm run build",
		"lint:package": "publint --pack npm --strict",
		"build:emit": "node scripts/package-runtime.mjs clean && tsc -p tsconfig.build.json && node scripts/package-runtime.mjs",
		"api:update": "npm run build:emit && api-extractor run --local"
	},
	"dependencies": {
		"@stricli/core": "1.3.0",
		"es-toolkit": "1.52.0",
		"is-record": "0.1.1",
		"json-beautify": "2.0.0",
		"load-json-file": "7.0.1",
		"p-map": "7.0.8",
		"path-exists": "5.0.0",
		"semver": "7.8.5",
		"untildify": "6.0.0",
		"write-json-file": "7.0.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@microsoft/api-extractor": "7.59.2",
		"@types/node": "26.6.3",
		"@types/semver": "7.8.0",
		"prettier": "3.9.9",
		"publint": "0.3.24",
		"raycast-app-source": "file:packages/raycast-source",
		"typescript": "7.0.2"
	},
	"description": "Local Raycast database and configuration tools",
	"bin": {
		"raycast": "./dist/src/cli/main.mjs"
	},
	"exports": {
		"./v1": {
			"types": "./dist/v1.d.mts",
			"default": "./dist/src/public/v1/index.mjs"
		},
		"./schemas/config.schema.json": "./schemas/config.schema.json",
		"./schemas/themes.schema.json": "./schemas/themes.schema.json"
	},
	"files": [
		"dist/",
		"README.md",
		"schemas/"
	]
}
