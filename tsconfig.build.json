{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"outDir": "dist",
		"rootDir": ".",
		"rewriteRelativeImportExtensions": true
	},
	"include": ["*.ts", "*.cts", "src/**/*.ts", "src/**/*.cts"],
	"exclude": [
		"scripts",
		"dist",
		"src/source/ast.ts",
		"src/source/bindings.ts",
		"src/source/analysis.ts",
		"src/source/corpus.ts"
	]
}
