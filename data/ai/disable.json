{
	"backupVersion": 1,
	"fallbackCommandIds": ["c:r:ai::-::openQuickAi"],
	"frecencyPrefixes": [
		"c:r:ai:",
		"c:r:dictation:",
		"c:r:translator:",
		"c:r:screen-awareness:"
	],
	"mergeableBackupCollections": [
		"internalExtensions",
		"commandSettings",
		"userDefaults",
		"models",
		"macOSDefaults"
	],
	"userDefaults": [
		{ "key": "has-initialized-ai-skill-directories", "value": true }
	],
	"internalExtensions": [
		{
			"id": "e:r:ai",
			"syncedMeta": {
				"aiMemoryEnabled": false,
				"aiToolConfirmationAllowList": [],
				"aiChatBackgroundNotificationsEnabled": false,
				"aiChatToolConfirmationMode": "confirm",
				"aiChatAutoReviewRules": []
			},
			"localMeta": {
				"aiByokApiKeys": [],
				"skillDirectories": [],
				"remoteAiChatEnabled": false,
				"remoteAiChatKeepAvailable": false,
				"aiLocalSubscriptionsEnabled": false,
				"aiClaudeSubscriptionEnabled": false,
				"aiCodexSubscriptionEnabled": false,
				"aiCopilotSubscriptionEnabled": false,
				"quickAiAutocompleteInRootSearch": false,
				"quickAiAutocompletePromptHistory": false,
				"showAgentsInRootSearch": false,
				"aiChatPreventIdleSleep": false,
				"aiUsageMenuBarEnabled": false
			},
			"enabledFallbackCommandIds": [],
			"enabled": false
		},
		{
			"id": "e:r:dictation",
			"syncedMeta": {
				"appContext": false,
				"autoDetectStyle": false
			},
			"enabled": false
		},
		{
			"id": "e:r:translator",
			"enabled": false
		},
		{
			"id": "e:r:mcp",
			"enabled": false
		},
		{
			"id": "e:r:screen-awareness",
			"enabled": false
		},
		{
			"id": "e:r:file-search",
			"localMeta": {
				"contentSearchEngine": "native",
				"semanticIndexingPaths": [],
				"semanticIndexingUseFileSearchScope": false
			}
		}
	],
	"commandSettings": [
		{ "id": "c:r:browser::-::aiExtension", "extensionId": "e:r:browser" },
		{ "id": "c:r:calculator::-::aiExtension", "extensionId": "e:r:calculator" },
		{ "id": "c:r:calendar::-::aiExtension", "extensionId": "e:r:calendar" },
		{
			"id": "c:r:clipboard-history::-::aiExtension",
			"extensionId": "e:r:clipboard-history"
		},
		{ "id": "c:r:contacts::-::aiExtension", "extensionId": "e:r:contacts" },
		{ "id": "c:r:developer::-::aiExtension", "extensionId": "e:r:developer" },
		{
			"id": "c:r:file-search::-::aiExtension",
			"extensionId": "e:r:file-search"
		},
		{
			"id": "c:r:file-search::-::fileExplorerAiExtension",
			"extensionId": "e:r:file-search"
		},
		{
			"id": "c:r:file-search::-::fileSearchAiExtension",
			"extensionId": "e:r:file-search"
		},
		{
			"id": "c:r:raycast-focus::-::aiExtension",
			"extensionId": "e:r:raycast-focus"
		},
		{ "id": "c:r:notes::-::aiExtension", "extensionId": "e:r:notes" },
		{ "id": "c:r:quicklinks::-::aiExtension", "extensionId": "e:r:quicklinks" },
		{
			"id": "c:r:raycast-core::-::askManual",
			"extensionId": "e:r:raycast-core"
		},
		{
			"id": "c:r:raycast-core::-::askFeedback",
			"extensionId": "e:r:raycast-core"
		},
		{
			"id": "c:r:raycast-core::-::askStore",
			"extensionId": "e:r:raycast-core"
		},
		{
			"id": "c:r:raycast-settings::-::aiExtension",
			"extensionId": "e:r:raycast-settings"
		},
		{ "id": "c:r:snippets::-::aiExtension", "extensionId": "e:r:snippets" }
	],
	"statusFields": [
		{
			"key": "contentSearchEngine",
			"path": ["localMeta", "contentSearchEngine"]
		},
		{
			"key": "enabled",
			"path": ["enabled"]
		},
		{
			"key": "enabledFallbackCommandIds",
			"path": ["enabledFallbackCommandIds"],
			"defaultValue": []
		},
		{
			"key": "aiMemoryEnabled",
			"path": ["syncedMeta", "aiMemoryEnabled"]
		},
		{
			"key": "skillDirectories",
			"path": ["localMeta", "skillDirectories"]
		},
		{
			"key": "aiByokApiKeyCount",
			"path": ["localMeta", "aiByokApiKeys"],
			"count": true
		},
		{
			"key": "semanticIndexingPaths",
			"path": ["localMeta", "semanticIndexingPaths"]
		},
		{
			"key": "semanticIndexingUseFileSearchScope",
			"path": ["localMeta", "semanticIndexingUseFileSearchScope"]
		},
		{
			"key": "aiToolConfirmationAllowList",
			"path": ["syncedMeta", "aiToolConfirmationAllowList"]
		},
		{
			"key": "aiChatBackgroundNotificationsEnabled",
			"path": ["syncedMeta", "aiChatBackgroundNotificationsEnabled"]
		},
		{
			"key": "aiChatToolConfirmationMode",
			"path": ["syncedMeta", "aiChatToolConfirmationMode"]
		},
		{
			"key": "aiChatAutoReviewRules",
			"path": ["syncedMeta", "aiChatAutoReviewRules"]
		},
		{
			"key": "remoteAiChatEnabled",
			"path": ["localMeta", "remoteAiChatEnabled"]
		},
		{
			"key": "remoteAiChatKeepAvailable",
			"path": ["localMeta", "remoteAiChatKeepAvailable"]
		},
		{
			"key": "aiLocalSubscriptionsEnabled",
			"path": ["localMeta", "aiLocalSubscriptionsEnabled"]
		},
		{
			"key": "aiClaudeSubscriptionEnabled",
			"path": ["localMeta", "aiClaudeSubscriptionEnabled"]
		},
		{
			"key": "aiCodexSubscriptionEnabled",
			"path": ["localMeta", "aiCodexSubscriptionEnabled"]
		},
		{
			"key": "aiCopilotSubscriptionEnabled",
			"path": ["localMeta", "aiCopilotSubscriptionEnabled"]
		},
		{
			"key": "quickAiAutocompleteInRootSearch",
			"path": ["localMeta", "quickAiAutocompleteInRootSearch"]
		},
		{
			"key": "quickAiAutocompletePromptHistory",
			"path": ["localMeta", "quickAiAutocompletePromptHistory"]
		},
		{
			"key": "showAgentsInRootSearch",
			"path": ["localMeta", "showAgentsInRootSearch"]
		},
		{
			"key": "aiUsageMenuBarEnabled",
			"path": ["localMeta", "aiUsageMenuBarEnabled"]
		},
		{
			"key": "aiChatPreventIdleSleep",
			"path": ["localMeta", "aiChatPreventIdleSleep"]
		}
	],
	"macOSDefaults": [
		{
			"key": "raycast_HasOpenedAIChat",
			"restoreType": "bool"
		},
		{
			"key": "NSWindow Frame ai-chat-window",
			"restoreType": "string"
		}
	],
	"aiDataQueries": [
		{
			"key": "chatCount",
			"methodPath": ["ai", "chatGetAllIds"]
		},
		{
			"key": "quickAiChatCount",
			"methodPath": ["ai", "chatGetAllInvalidationSnapshots"],
			"filter": {
				"path": ["source"],
				"equals": "quick_ai"
			}
		},
		{
			"key": "commandCount",
			"methodPath": ["ai", "commandGetAll"]
		},
		{
			"key": "modeCount",
			"methodPath": ["ai", "modeGetAll"]
		},
		{
			"key": "transcriptionCount",
			"methodPath": ["ai", "transcriptionGetAll"]
		},
		{
			"key": "transcriptionStyleCount",
			"methodPath": ["ai", "transcriptionStyleGetAll"]
		},
		{
			"key": "mcpServerCount",
			"methodPath": ["settings", "allMcpServers"]
		},
		{
			"key": "orgSkillCount",
			"methodPath": ["orgPacks", "listOrgSkills"]
		},
		{
			"key": "orgAgentCount",
			"methodPath": ["orgPacks", "listOrgAiAgents"]
		},
		{
			"key": "scheduledMessageCount",
			"methodPath": ["ai", "scheduledMessageGetAll"]
		},
		{
			"key": "folderCount",
			"methodPath": ["ai", "folderGetAll"]
		}
	]
}
