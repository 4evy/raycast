{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Raycast themes",
	"description": "Theme file consumed by installThemes and the themes CLI; runtime validation additionally rejects duplicate name/appearance pairs",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string",
			"description": "Editor schema association; ignored at runtime"
		},
		"themes": {
			"type": "array",
			"minItems": 1,
			"items": {
				"type": "object",
				"properties": {
					"name": {
						"type": "string",
						"minLength": 1
					},
					"appearance": {
						"enum": ["light", "dark"]
					},
					"colors": {
						"type": "object",
						"properties": {
							"background": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"backgroundSecondary": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"foreground": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"accent": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"selection": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"loader": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"red": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"orange": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"yellow": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"green": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"blue": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"purple": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							},
							"magenta": {
								"type": "string",
								"pattern": "^#[0-9a-fA-F]{6}$"
							}
						},
						"required": [
							"background",
							"backgroundSecondary",
							"foreground",
							"accent",
							"selection",
							"loader",
							"red",
							"orange",
							"yellow",
							"green",
							"blue",
							"purple",
							"magenta"
						],
						"additionalProperties": false
					}
				},
				"required": ["name", "appearance", "colors"]
			}
		}
	},
	"required": ["themes"]
}
